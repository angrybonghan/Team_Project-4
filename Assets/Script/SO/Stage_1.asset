  DialogueText:
  - "\uC800\uAE30?"
  - ...?
  - "\uB108\uB3C4 \uB3C4\uBC15\uD558\uB7EC \uC654\uC5B4?"
  - "(\uC545\uB9C8\uB85C\uB294 \uC548 \uBCF4\uC774\uB294\uB370...)"
  - "\uB9DE\uC544."
  - "\uD314\uC790 \uB300\uAC00\uB9AC \uB188\uC774 \uC601\uD63C\uC744 \uAC78\uACE0
    \uB3C4\uBC15\uC744 \uD558\uC790 \uD588\uC5B4."
  - "\uC774 \uB54C, \uC800 \uBA40\uB9AC\uC11C \uB204\uAD70\uAC00 \uB9D0\uD558\uACE0
    \uC788\uC5C8\uB2E4."
  - "\uB098\uC758 STATIC-\uD55C \uB3C4\uBC15\uC7A5\uC5D0 \uC624\uC2E0 \uAC83\uC744
    \uD658\uC601\uD569\uB2C8\uB2E4!!!!!"
  - "\uC5EC\uAE30\uB294 \uC601\uD63C\uC744 \uAC78 \uC218 \uC788\uB294 \uAD6D\uB0B4
    \uCD5C\uCD08!"
  - "\uC545\uB9C8\uB4E4\uC758 \uCC9C\uAD6D!"
  - "\uADF8 \uC774\uB984\uD558\uC5EC....."
  - "'\uD30C \uB79C\uB4DC' \uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4\uC544\uC544\uC544\uC559\u313A!!"
  - "\uC2B9\uB9AC\uD558\uBA74 \uC0C1\uB300\uBC29\uC758 \uBAA8\uB4E0 \uAC83\uC744
    \uC5BB\uC2B5\uB2C8\uB2E4! EVERYTHING!"
  - "\uBD80, \uBA85\uC131, \uD798\uAE4C\uC9C0! \uADF8\uC57C\uB9D0\uB85C \uBAA8\uB4E0
    \uAC83\uC774 \uC774\uACF3\uC5D0 \uC788\uC2B5\uB2C8\uB2E4!"
  - "\uADF8\uB798. \uBC14\uB85C \uC800 \uB300\uAC00\uB9AC\uC57C."
  - ".. \uC800 \uB300\uAC00\uB9AC \uC870\uC2EC\uD558\uB294 \uAC8C \uC88B\uC544."
  - "\uC774 \uCE74\uC9C0\uB178\uC758 \uB300\uAC00\uB9AC\uC57C."
  - "\uB300\uAC00\uB9AC\uB791 \uB300\uACB0\uD558\uB2E4\uAC00 \uB0B4 \uB300\uAC00\uB9AC\uAC00
    \uBF51\uD788\uACE0\uC57C \uB9D0\uC558\uC5B4."
  - "... \uC5B4\uC9C0\uAC04\uD788 \uD798\uB4E4\uC5C8\uB098 \uBCF4\uAD6C\uB098?"
  - "\uADF8\uB798\uC11C \uB9D0\uC778\uB370... \uC81C\uC548\uD560 \uAC8C \uC788\uC5B4."
  - "\uC800 \uD314\uC790 \uB300\uAC00\uB9AC. \uC800\uB188\uD55C\uD14C \uC774\uAE30\uBA74
    \uC800\uB188\uC758 \uC601\uD63C\uC744 \uBE7C\uC557\uC744 \uC218 \uC788\uC5B4."
  - "\uB09C \uC800\uB188\uC758 \uBAB8\uB6B1\uC544\uB9AC\uB97C \uB0B4\uAC00 \uCDE8\uD558\uACA0\uB2E4."
  - "\uB10C \uC800\uB188\uC758 \uBD80\uC640 \uBA85\uC608\uB97C \uAC00\uC838. \uC5B4\uB54C?"
  - "\uB0B4\uAC00... \uC774 \uAC8C\uC784\uC744 \uC774\uAE30\uAC8C \uD574\uC904 \uC218
    \uC788\uC5B4."
  - ....
  - "\uAE4C\uC9D3\uAC70 \uD574\uBCF4\uC9C0 \uBB50"
  - "\uC88B\uC544! \uC774 \uAC8C\uC784\uC740 \uC77C\uBC18\uC801\uC778 \uB2F9\uAD6C\uC640\uB294
    \uB2EC\uB77C."
  - "\uB124 \uBAA9\uD45C\uB294 \uAC80\uC815\uC0C9 8\uBCFC\uC744 \uAD6C\uBA4D \uC548\uC73C\uB85C
    \uB123\uB294 \uAC70\uC57C."
  - "\uADF8 \uC804\uC5D0, \uB124 \uACF5\uC744 8\uB85C \uB9CC\uB4E4 \uD544\uC694\uAC00
    \uC788\uC5B4."
  - "\uC88B\uC544. \uC5B4\uB5BB\uAC8C \uD574\uC57C \uB0B4 \uACF5\uC744 8\uB85C \uB9CC\uB4E4
    \uC218 \uC788\uC9C0?"
  - ".. \uC124\uBA85\uD558\uAE30\uC5D0\uB294 \uAE38\uC5B4."
  - "\uB0B4 \uB3C4\uAC10\uC744 \uBE4C\uB824 \uC904\uAC8C."
  - "\uAF64 \uC27D\uAC8C \uD560 \uC218 \uC788\uC744 \uAC70\uC57C."
  - "(\uD654\uBA74 \uC624\uB978\uCABD \uC704\uC758 \uB3C4\uAC10\uC744 \uD074\uB9AD\uD574\uC11C
    \uC5F4 \uC218 \uC788\uB2E4.)"
